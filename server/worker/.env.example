# server/worker/.env (docker compose env_file). Never commit the real one.
DATABASE_URL=postgresql://sgl:CHANGE_ME@CHANGE_ME.vultrdb.com:16751/sgl?sslmode=require
# Diagnostic label only; ownership uses per-claim UUID leases (120s, renewed every 30s).
WORKER_NAME=sgl-gpu-1
POLL_SECONDS=3

# Object Storage (private bucket; photos/<job>/ in, builds/<job>/ out)
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=sgl64
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Vision model (OpenAI-compatible chat completions with image input).
# Local vLLM (docker compose --profile vllm):
VLM_BASE_URL=http://vllm:8000/v1
VLM_API_KEY=local
VLM_MODEL=qwen2.5-vl-7b
# Vultr Serverless Inference instead (if it offers a vision model):
#VLM_BASE_URL=https://api.vultrinference.com/v1
#VLM_API_KEY=CHANGE_ME
#VLM_MODEL=CHANGE_ME
VLM_TIMEOUT=120
# 1: fail the job when the model fails; 0 (default): fall back to photo colours + defaults
VLM_REQUIRED=0

# Pipeline
BUILD_TIMEOUT=600
SGL_RETRIES=3
USE_OPENCV=1
KEEP_WORKDIR=0
KEEP_FAILED=0
