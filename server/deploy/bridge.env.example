# /etc/sgl/bridge.env for sgl-bridge.service (mode 600, owner root). Copy this file and fill it in.
# Empty Auth0 values: /login answers "unavailable". Empty API / M2M values: events are only logged, no deploys.

# --- game ---------------------------------------------------------------------------------------
SGL_SAVEPATH=/srv/sgl
# SGL_MOD_DIR=/srv/sgl/mods/sgl64            (default: $SGL_SAVEPATH/mods/sgl64)
# SGL_BRIDGE_STATE=/srv/sgl/bridge           (roster.json of deployed guest slots)
GAME_CWD=/opt/sm64coopdx
# Full command override (default = the flags of sgl-game.service with --savepath $SGL_SAVEPATH):
# GAME_CMD=/opt/sm64coopdx/sm64coopdx --headless --server 7777 --savepath /srv/sgl --enable-mod sgl64 --playername Campus --playercount 16 --no-discord --skip-update-check
# GAME_LINE_BUFFER=1                         (run the game under `stdbuf -oL` when available)

# --- Auth0: "Gator Pass" native app (device code grant) ---------------------------------------
AUTH0_DOMAIN=login.gatorcamp.us
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.gatorcamp.us
# AUTH0_ISSUER=https://login.gatorcamp.us/   (default https://$AUTH0_DOMAIN/)

# --- API + M2M app (client credentials, scope `bridge` only) ----------------------------------
API_URL=https://api.gatorcamp.us
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# AUTH0_M2M_DOMAIN=<tenant>.us.auth0.com     (default: $AUTH0_DOMAIN)

# --- deploys (spec 5.3) -------------------------------------------------------------------------
# SGL_DEPLOYS=1
# SGL_DEPLOY_POLL=30                         (seconds between GET /deploys/pending)
# SGL_DEPLOY_MIN_GAP=300                     (at most one game restart per 5 minutes)
# SGL_DEPLOY_ANNOUNCE=60                     (warning before a restart while players are online)
# SGL_PLACEHOLDER_MOD=/opt/sgl/mods/sgl64    (shipped guest placeholders; default: the repo copy next to the bridge)
# SGL_ACTOR_RENAME=/opt/sgl/server/worker/actor_rename.py
