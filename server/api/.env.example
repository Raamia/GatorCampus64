# GatorCampus 64 API (server/api). Copy to /etc/sgl/api.env (mode 600) or server/api/.env.
# Every setting is read from the environment; nothing else is configured anywhere.

# Vultr Managed PostgreSQL (sslmode=require for the managed instance)
DATABASE_URL=postgresql://sgl:CHANGE_ME@vultr-prod-xxxx.vultrdb.com:16751/sgl?sslmode=require
# Apply schema.sql at startup (idempotent). Or run: python -m sgl_api.schema
SGL_APPLY_SCHEMA=1

# Site domain. AUTH0_ISSUER, AUTH0_AUDIENCE, AUTH0_CLAIM_NAMESPACE, CORS_ORIGINS and PLAY_ADDRESS
# default from it (login.<d>, api.<d>, https://<d>/, https://<d> + www.<d>, play.<d>:7777).
SGL_DOMAIN=gatorcamp.us

# Auth0 (§7.3). The issuer is the custom domain when tokens are issued through it; keep the trailing slash.
AUTH0_ISSUER=https://login.gatorcamp.us/
AUTH0_AUDIENCE=https://api.gatorcamp.us
# Namespace of the post-login Action's custom claims (<ns>uf, <ns>nickname)
#AUTH0_CLAIM_NAMESPACE=https://gatorcamp.us/
# Shown by GET /status
#PLAY_ADDRESS=play.gatorcamp.us:7777
# Defaults to <issuer>.well-known/jwks.json
#AUTH0_JWKS_URL=

# Vultr Object Storage (S3-compatible), private bucket
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=sgl64
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Lifetime of presigned preview / artifact URLs, seconds
PRESIGN_TTL=900

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=https://gatorcamp.us,https://www.gatorcamp.us

# Limits (§5.1, §7.4)
MAX_PHOTO_BYTES=8388608
PHOTO_MAX_SIDE=1024
LIMIT_USER_ACTIVE=1
LIMIT_USER_TOTAL=3
LIMIT_GLOBAL_HOUR=20
LINK_CODE_TTL=600
# /status heartbeat expiry (bridge sends every 20s); use >=60. Zero/negative uses 90.
STATUS_STALE_SECS=90

# Verified leaderboards (§10.2): GET /leaderboards responses are reused for this many seconds (0 = off)
LEADERBOARD_CACHE_SECS=5
# §10.4: push each ranked run to the DeepSpace app (Gator Field Board). Disabled unless both are set.
# The secret must equal the app's DeepSpace secret DEEPSPACE_INGEST_SECRET (openssl rand -hex 32).
#DEEPSPACE_APP_URL=https://gator-field-board.app.space
#DEEPSPACE_INGEST_SECRET=CHANGE_ME
# Outbox sweep interval (s), attempts before a push is marked failed, request timeout (s)
#DEEPSPACE_PUSH_INTERVAL=30
#DEEPSPACE_PUSH_MAX_ATTEMPTS=20
#DEEPSPACE_TIMEOUT=5
