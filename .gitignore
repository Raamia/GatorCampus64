# Nintendo's ROM and save files: never commit these
*.z64
*.n64
*.v64
*.eeprom

# The sm64coopdx game itself (download it from its GitHub releases page instead)
sm64coopdx.app/
download/

# Blender autosaves
*.blend1
*.blend2

.DS_Store
**/.build/

# Raw reference photos of friends and the school stay local (only game textures get committed)
reference/

# Local Python tools environment
tools/.venv/

# Downloaded third-party tools (Fast64-Gart add-on, coopdx model template)
tools/vendor/
tools/blender-scripts/addons/

# Built Blender files are regenerated by tools/blender/build_character.py
art/*/build/*.blend
art/*/build/*.blend1

# Face-art drafts and judge scratch from the texture workflows (finals live in art/<id>/textures/)
art/*/candidates/
art/*/judging/

__pycache__/
tools/blender-scripts/
art/*/build/tex/

# Raw OpenStreetMap tiles (re-downloadable; data/uf/campus.json is the processed copy)
data/uf/tiles/

# DynOS compiles these at game launch (only in the installed copy, but just in case)
mods/*/levels/*.lvl
mods/*/actors/*.bin

# Stage preview renders are regenerated by tools/campus/build_stage.py --previews (curated copies live in art/levels/<stage>/showcase/)
art/levels/*/previews/
art/levels/*/landmarks/

# Before/after comparison renders from polish passes (local only)
art/*/build/compare/

# Contact sheets and photo-vs-render comparisons contain downloaded third-party photos: local only
art/levels/*/reference_sheets/
art/levels/*/compare/

# Local hand-off bundles (third-party add-ons/templates): never commit
dist/

# Gemini API key for tools/npc_bridge (never commit it)
tools/npc_bridge/.env
tools/npc_bridge/unanswered.log

# Server venvs, caches and local env files (server/*/.env.example are the templates)
/.env
server/**/.venv
.pytest_cache/
server/**/.env

# Claude Code agent worktrees
.claude/worktrees/
