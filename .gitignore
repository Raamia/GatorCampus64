# Nintendo's ROM and save files: never commit these
*.z64
*.n64
*.v64
*.eeprom

# The sm64coopdx game itself (download it from its GitHub releases page instead)
sm64coopdx.app/
download/

# Blender autosaves
*.blend1
*.blend2

.DS_Store

# Raw reference photos of friends and the school stay local (only game textures get committed)
reference/

# Local Python tools environment
tools/.venv/

# Downloaded third-party tools (Fast64-Gart add-on, coopdx model template)
tools/vendor/
tools/blender-scripts/addons/

# Built Blender files are regenerated by tools/blender/build_character.py
art/*/build/*.blend
art/*/build/*.blend1

# Face-art drafts and judge scratch from the texture workflows (finals live in art/<id>/textures/)
art/*/candidates/
art/*/judging/

__pycache__/
tools/blender-scripts/
art/*/build/tex/

# Raw OpenStreetMap tiles (re-downloadable; data/uf/campus.json is the processed copy)
data/uf/tiles/
